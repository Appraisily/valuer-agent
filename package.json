{
  "name": "appraisily-valuer-bridge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run env:check && npx rimraf dist && npx tsc --project tsconfig.node.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "node scripts/smoke/valuer-bridge-smoke.mjs",
    "smoke:deploy": "node scripts/smoke/deploy-smoke.mjs",
    "smoke:env": "node scripts/smoke/runtime-env-smoke.mjs",
    "smoke:logs": "node scripts/smoke/log-smoke.mjs",
    "env:check": "node ../../env-governance/run-check.mjs --schema services/valuer-agent",
    "prestart": "npm run env:check",
    "predev": "npm run env:check"
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "express": "^4.22.2",
    "pg": "^8.16.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.9.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "flatted": "3.4.2"
  }
}
