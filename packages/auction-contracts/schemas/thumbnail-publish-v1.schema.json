{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appraisily.com/schemas/thumbnail-publish-v1.json",
  "title": "Thumbnail publish request and result v1",
  "$defs": {
    "request": { "type": "object", "required": ["schemaVersion", "requestId", "correlationId", "lotUids"], "properties": { "schemaVersion": { "const": 1 }, "requestId": { "type": "string", "minLength": 1 }, "correlationId": { "type": "string", "minLength": 1 }, "lotUids": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 4 } }, "additionalProperties": false },
    "result": { "type": "object", "required": ["schemaVersion", "requestId", "requested", "processed", "publishedCount", "skippedCount", "failedCount"], "properties": { "schemaVersion": { "const": 1 }, "requestId": { "type": "string", "minLength": 1 }, "requested": { "type": "integer", "minimum": 0 }, "processed": { "type": "integer", "minimum": 0 }, "publishedCount": { "type": "integer", "minimum": 0 }, "skippedCount": { "type": "integer", "minimum": 0 }, "failedCount": { "type": "integer", "minimum": 0 } }, "additionalProperties": true }
  }
}

